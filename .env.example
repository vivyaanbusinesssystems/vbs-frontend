# Copy the names you need into .env for local work. .env is NOT committed (it is git-ignored).
#
# PRODUCTION: set these same names in your hosting dashboard (Environment variables), then redeploy.
# The build reads them from there. Use real https addresses, never localhost.

# The company website's own backend (enquiry form -> saves the lead and emails you)
VITE_BASE_URL=https://your-company-backend.example.com

# The SaaS platform's backend API, WITH /api at the end. The Pricing page reads the live plans from
# {VITE_SAAS_API_URL}/public/plans, so a price changed in the superadmin (More > Plan defaults) shows here.
# Leave it empty and the page shows the built-in default prices instead.
# The platform backend must also list this website in its CORS_ORIGINS setting, for example
#   CORS_ORIGINS=https://www.vivyaanbusinesssystems.com,https://vivyaanbusinesssystems.com
VITE_SAAS_API_URL=https://your-platform-app.onrender.com/api
